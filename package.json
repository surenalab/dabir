  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "relay:build": "esbuild relay/server.mjs --bundle --platform=node --format=cjs --outfile=relay/dist/relay.cjs --log-level=warning",
