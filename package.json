    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check": "sh scripts/check.sh",
    "test:rust": "cd src-tauri && CARGO_TARGET_DIR=target/test cargo test",
    "review": "node scripts/review.mjs",
    "test:review": "node --test scripts/review.test.mjs"
