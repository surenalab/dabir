{
  "name": "dabir-mcp",
  "private": true,
  "version": "0.2.5",
  "description": "Dabir in Claude Desktop: an MCP server whose panel shows the paper's PDF and every change to review, hunk by hunk.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "pack": "node build.mjs --mcpb",
    "test": "node build.mjs && node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "diff": "9.0.0",
    "pdfjs-dist": "5.4.530",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.10.0",
    "codemirror-lang-latex": "0.6.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
