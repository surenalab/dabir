{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:default",
    "updater:default",
    "process:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "mailto:*"
        },
        {
          "url": "sms:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
