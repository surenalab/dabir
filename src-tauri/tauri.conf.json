{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dabir",
  "version": "0.1.5",
  "identifier": "com.surenalab.dabir",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/fetch-tectonic.mjs && node scripts/clean-sample.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dabir",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tectonic"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "resources": {
      "../templates": "templates/",
      "../examples/score-anchor": "examples/score-anchor/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBODJEOUQ5QzM4MzM4QkYKUldTL09JUEQyZG1DV28xTXJEc3JuUDIwMGY2amhQbUd2V3pRNmp5N21SNXJaRllJOFN2UnRTMVUK",
      "endpoints": [
        "https://github.com/surenalab/dabir/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "dabir"
        ]
      }
    }
  }
}
